# /root/.cnb/register.env  --  chmod 600, root only
#
# Shared secret expected by cnb-register.py on its POST /register endpoint
# (header: X-Reg-Token). The CNB workspace pipeline sends the same value from
# its private secrets repository. Generate one with:
#
#     openssl rand -hex 24
#
# This file is a TEMPLATE. Never commit the filled-in copy.
REG_TOKEN=REPLACE_WITH_A_LONG_RANDOM_SHARED_SECRET
