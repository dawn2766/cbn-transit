# /etc/cnb-ai-watchdog.env  --  chmod 600, root only
#
# Configuration for /usr/local/bin/cnb-ai-watchdog.sh (the relay's recovery
# controller, run once per minute from root's crontab).
#
# This file is a TEMPLATE. Copy it to /etc/cnb-ai-watchdog.env on the relay and
# replace every value below. Never commit the filled-in copy: it holds a CNB
# personal access token that can list and stop your workspaces.

# Code repository (the CNB fork of cnb2dsh) whose workspace runs the API proxy.
CNB_REPO=YOUR_ORG/cnb2dsh

# Public health URL of your fixed domain.
FIXED_URL=https://ai.example.com/health

# Self-registration endpoint served by nginx -> cnb-register.py.
REGISTER_URL=https://ai.example.com/ops/register

# Personal CNB platform token. Needs read access to the workspace list of
# CNB_REPO; the same value NEVER goes into the code repository.
CNB_TOKEN=REPLACE_WITH_CNB_PERSONAL_ACCESS_TOKEN

# Workspace port carrying src/server.mjs.
UPSTREAM_PORT=9001

# Per-probe HTTP timeout in seconds.
PROBE_TIMEOUT=3

# Optional overrides (defaults shown):
#REGISTER_ENV_FILE=/root/.cnb/register.env
#CNB_API=https://api.cnb.cool
#WATCHDOG_LOG=/var/log/cnb-ai-watchdog.log
#WATCHDOG_STATE_DIR=/var/lib/cnb-ai-watchdog
#START_COOLDOWN=600
#POLL_INTERVAL=15
#POLL_MAX=300
#REGISTER_WAIT=90
#FAKEDEATH_THRESHOLD=5
#FAKEDEATH_COOLDOWN=1800
